# Panel de contenido · Dando de Más©
# Todas las URLs pasan por index.php, salvo los archivos reales (assets/).
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L]
</IfModule>

# Nunca servir configuración ni archivos ocultos
<FilesMatch "^(config(\.ejemplo)?\.php|\.git.*|\.env.*|\.DS_Store)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
